# Copy this file to .env and add your newly rotated keys. Never commit .env.
# Recommended: use one shared key or separate keys for the two tasks.
OPENROUTER_API_KEY=
OPENROUTER_VISION_API_KEY=
OPENROUTER_CHAT_API_KEY=

# Optional direct-provider fallbacks.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional live URL reputation lookup (Google Cloud Web Risk; keep this key private).
WEB_RISK_API_KEY=

# Optional model overrides
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash
OPENROUTER_CHAT_MODEL=qwen/qwen3.8-27b
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=qwen/qwen3.8-27b

# Optional local proxy settings
HOST=127.0.0.1
PORT=8787
