# Copy this file to .env and add your newly rotated keys. Never commit .env.
# Required for chat and Groq image analysis.
GROQ_API_KEY=
# Optional: tried first for image analysis; Groq is the fallback.
GEMINI_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=qwen/qwen3.8-27b

# Optional local proxy settings
HOST=127.0.0.1
PORT=8787
