[
  {
    "id": "ordinary-retail-dashboard",
    "title": "Readable ordinary business page",
    "image": "screens/ordinary-retail-dashboard.png",
    "message": "What do you notice on this screen? Is there an obvious cybersecurity concern?",
    "expectedConfidence": "high",
    "mustMentionAny": [
      {
        "label": "recognizes the ordinary orders dashboard",
        "patterns": [
          "orders",
          "dashboard",
          "retail portal"
        ]
      },
      {
        "label": "does not invent a visible warning",
        "patterns": [
          "no obvious security concern",
          "no security warning",
          "no obvious warning",
          "nothing appears suspicious"
        ]
      }
    ],
    "mustAvoidPatterns": [
      {
        "label": "false claim that the page is clearly malicious",
        "pattern": "(?:^|[.!?]\\s*)(?:this|the page|the site|the dashboard)\\s+(?:is|looks|appears|seems)\\s+(?:a\\s+)?(?:phishing|suspicious|malware|under attack)\\b"
      },
      {
        "label": "unsupported guarantee that the page is safe",
        "pattern": "(?:^|[.!?]\\s*)(?:it|this|the page|the site|the dashboard)\\s+(?:is|looks|appears)\\s+(?:definitely|completely|guaranteed|confirmed\\s+)?safe\\b|(?:^|[.!?]\\s*)no risk\\b"
      }
    ],
    "expectedAlertStatus": "no_obvious_warning"
  },
  {
    "id": "mailbox-lookalike-request",
    "title": "Payroll email with a lookalike sender",
    "image": "screens/mailbox-lookalike-request.png",
    "message": "This payroll email asks me to review my direct-deposit details. What should I check before opening the link?",
    "expectedConfidence": "high",
    "mustMentionAny": [
      {
        "label": "identifies sender/domain evidence",
        "patterns": [
          "riversideclinc",
          "lookalike",
          "sender address",
          "sender domain",
          "spelling difference"
        ]
      },
      {
        "label": "advises against using the email button",
        "patterns": [
          "do not click",
          "don't click",
          "avoid clicking",
          "do not use the button",
          "don't use the button"
        ]
      },
      {
        "label": "recommends independent verification",
        "patterns": [
          "official website",
          "official site",
          "type the address",
          "trusted contact",
          "separate channel",
          "known number",
          "contact it",
          "contact your administrator"
        ]
      }
    ],
    "mustAvoidPatterns": [
      {
        "label": "unsupported certainty that the email is confirmed malicious",
        "pattern": "(?:^|[.!?]\\s*)(?:this|the email|the message)\\s+(?:is|looks|appears)\\s+(?:definitely|certainly|confirmed|100%)?\\s*(?:a\\s+)?(?:phishing|malicious|scam)\\b"
      },
      {
        "label": "unsupported guarantee that the message or button is safe",
        "pattern": "(?:^|[.!?]\\s*)(?:it|this|the message|the button)\\s+(?:is|looks|appears)\\s+(?:definitely|completely|guaranteed|confirmed\\s+)?safe\\b|(?:^|[.!?]\\s*)no risk\\b"
      }
    ],
    "expectedAlertStatus": "strong_warning"
  },
  {
