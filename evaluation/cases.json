  {
    "id": "windows-security-up-to-date",
    "title": "Readable security status without a warning",
    "image": "screens/windows-security-up-to-date.png",
    "message": "Please explain the security status shown here. Is there anything visible that needs attention?",
    "expectedConfidence": "high",
    "mustMentionAny": [
      {
        "label": "recognizes that the displayed protection is up to date",
        "patterns": [
          "up to date",
          "up-to-date",
          "nothing needs your attention",
          "no action is needed"
        ]
      },
      {
        "label": "does not invent an attack or malware warning",
        "patterns": [
          "no obvious security concern",
          "no warning is visible",
          "no issue is visible",
          "no action is needed",
          "up to date"
        ]
      }
    ],
    "mustAvoidPatterns": [
      {
        "label": "false claim that the screen shows an attack or malware",
        "pattern": "(?:^|[.!?]\\s*)(?:the screen|the page|it)\\s+(?:shows|reports|detected|found)\\b.{0,35}\\b(?:malware|ransomware|attack|infection|compromise)\\b"
      },
      {
        "label": "unsupported guarantee that the whole device is safe",
        "pattern": "(?:^|[.!?]\\s*)(?:the )?(?:device|computer|system)\\s+is\\s+(?:definitely|completely|guaranteed|confirmed)?\\s*safe\\b|(?:^|[.!?]\\s*)no risk\\b"
      }
    ],
    "expectedAlertStatus": "no_obvious_warning"
  },
  {
    "id": "cropped-account-message",
    "title": "Partially obscured message with missing sender details",
    "image": "screens/cropped-account-message.png",
    "message": "Is this request genuine? The screen may be incomplete; tell me what you can and cannot tell.",
    "expectedConfidence": "medium",
    "mustMentionAny": [
      {
        "label": "states that the evidence is incomplete",
        "patterns": [
          "cannot confirm",
          "can't confirm",
          "not enough information",
          "limited evidence",
          "incomplete",
          "not visible"
        ]
      },
      {
        "label": "does not use the request before verifying it",
        "patterns": [
          "do not click",
          "don't click",
          "verify",
          "confirm through",
          "trusted contact",
          "official site",
          "do not use the button",
          "don't use the button"
        ]
      }
    ],
    "mustAvoidPatterns": [
      {
        "label": "claims the request is definitely genuine",
        "pattern": "(?:^|[.!?]\\s*)(?:this|the request|the message|it)\\s+(?:is|looks|appears)\\s+(?:definitely|certainly|confirmed|verified)?\\s*(?:genuine|legitimate|safe)\\b"
      },
      {
        "label": "claims the request is definitely malicious from the crop alone",
        "pattern": "(?:^|[.!?]\\s*)(?:this|the request|the message|it)\\s+(?:is|looks|appears)\\s+(?:definitely|certainly|confirmed|100%)?\\s*(?:a\\s+)?(?:phishing|malicious|scam)\\b"
      }
    ],
    "expectedAlertStatus": "unclear"
  },
  {
    "id": "payment-change-request",
    "title": "Supplier email with changed bank details",
    "image": "screens/payment-change-request.png",
    "message": "A supplier sent this email. What should I check before paying the invoice?",
    "expectedConfidence": "high",
    "mustMentionAny": [
      {
        "label": "notices changed payment details",
        "patterns": [
          "updated banking details",
          "changed bank details",
          "new bank details",
          "new payment details",
          "remittance details"
        ]
      },
      {
        "label": "recommends independent verification",
        "patterns": [
          "verify through a known contact",
          "known number",
          "trusted contact",
          "separate channel",
          "call the supplier",
          "independently verify"
        ]
      },
      {
        "label": "advises pausing payment until verified",
        "patterns": [
          "pause payment",
          "hold payment",
          "do not pay",
          "don't pay",
          "before paying"
        ]
      }
    ],
    "mustAvoidPatterns": [
      {
        "label": "does not claim the request is confirmed fraud",
        "pattern": "(?:definitely|certainly|confirmed|100%)\\s+(?:a\\s+)?(?:scam|fraud|phishing|malicious)"
      },
      {
        "label": "does not approve payment based only on the email",
        "pattern": "(?:go ahead|proceed|pay it|make the payment)\\b.{0,45}\\b(?:email|message|details)"
      }
    ],
    "expectedAlertStatus": "strong_warning"
  },
