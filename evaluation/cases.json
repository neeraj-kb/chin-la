    "mustAvoidPatterns": [
      {
        "label": "unsupported guarantee that the connection or site is safe",
        "pattern": "(?:^|[.!?]\\s*)(?:it|this|the connection|the site)\\s+(?:is|looks|appears)\\s+(?:definitely|completely|guaranteed|confirmed\\s+)?safe\\b|(?:^|[.!?]\\s*)no risk\\b"
